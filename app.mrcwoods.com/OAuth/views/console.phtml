            }
            
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // 复制文本
        function copyText(elementId) {
            const text = document.getElementById(elementId).textContent;
            navigator.clipboard.writeText(text).then(() => {
                showToast('已复制到剪贴板');
            }).catch(() => {
                showToast('复制失败', 'error');
            });
