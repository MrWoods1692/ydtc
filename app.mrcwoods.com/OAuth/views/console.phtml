// 使用axios库发送请求
const axios = require('axios');

// 换取访问令牌
async function getAccessToken(code) {
  try {
    const response = await axios.post('https://api.example.com/OAuth/public/token.php', 
      new URLSearchParams({
        grant_type: 'authorization_code',
        code: code,
        client_id: 'YOUR_CLIENT_ID',
        client_secret: 'YOUR_CLIENT_SECRET',
        redirect_uri: 'YOUR_REDIRECT_URI'
      })
    );
    return response.data;
  } catch (error) {
    console.error('获取令牌失败:', error.response.data);
    throw error;
  }
}

// 获取用户信息
async function getUserInfo(accessToken) {
  try {
    const response = await axios.get('https://api.example.com/OAuth/public/resource.php', {
      headers: {
        'Authorization': `Bearer ${accessToken}`
      }
    });
    return response.data;
  } catch (error) {
    console.error('获取用户信息失败:', error.response.data);
    throw error;
  }
}

