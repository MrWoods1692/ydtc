        // 重新生成密钥
        function regenerateSecret() {
            if (!confirm('重新生成密钥后，旧密钥将立即失效。所有使用旧密钥的集成都需要更新。确定继续？')) {
                return;
            }

            fetch('', {
                method: 'POST',
                body: new URLSearchParams({ action: 'regenerate_secret' })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('clientSecret').textContent = data.client_secret;
                    showToast(data.message);
                } else {
                    showToast(data.message, 'error');
                }
            })
            .catch(() => {
                showToast('操作失败，请稍后重试', 'error');
            });
        }

